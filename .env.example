# Environment Variables — SmartWash Pro
# Copy this file to .env and fill in your values

# ---- Database ----
DB_URL=jdbc:mysql://localhost:3306/smartwash_pro?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# ---- JWT ----
JWT_SECRET=your_very_long_secure_jwt_secret_key_at_least_256_bits_long_here
JWT_EXPIRATION_MS=86400000

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8080/api
